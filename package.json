{
  "name": "ax-mvp-factory-os",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --force",
    "preview": "vite preview",
    "test:contract": "vite build --config vite.contract.config.mjs && node .contract-out/contract.mjs",
    "test:client-ops": "vite build --config vite.client-ops.config.mjs && node .client-ops-out/client-ops.mjs",
    "test:client-operations": "vite build --config vite.client-operations.config.mjs && node .client-operations-out/client-operations.mjs",
    "test:progress": "vite build --config vite.progress.config.mjs && node .progress-out/progress.mjs",
    "test:persistence": "vite build --config vite.persistence.config.mjs && node .persistence-out/persistence.mjs",
    "test:onboarding": "vite build --config vite.onboarding.config.mjs && node .onboarding-out/onboarding.mjs",
    "test:client-ops-alerts": "vite build --config vite.client-ops-alerts.config.mjs && node .client-ops-alerts-out/client-ops-alerts.mjs",
    "test:doc-parser": "vite build --config vite.doc-parser.config.mjs && node .doc-parser-out/doc-parser.mjs",
    "test:client-ops-stage2": "vite build --config vite.client-ops-stage2.config.mjs && node .client-ops-stage2-out/stage2.mjs",
    "test:datamode": "vite build --config vite.datamode.config.mjs && node .datamode-out/datamode.mjs",
    "test:autherrors": "vite build --config vite.autherrors.config.mjs && node .autherrors-out/autherrors.mjs",
    "test:mirae-os": "vite build --config vite.mirae-os.config.mjs && node .mirae-os-out/mirae-os.mjs",
    "test:consulting": "vite build --config vite.consulting.config.mjs && node .consulting-out/consulting.mjs",
    "test:operator": "vite build --config vite.operator.config.mjs && node .operator-out/operator.mjs",
    "test:startup-tax": "vite build --config vite.startup-tax.config.mjs && node .startup-tax-out/startup-tax.mjs",
    "test:cretop": "node src/tools/cretop/__tests__/golden.test.mjs",
    "test:tools": "vite build --config vite.tools.config.mjs && node .tools-out/tools.mjs",
    "test:employment": "vite build --config vite.employment.config.mjs && node .employment-out/employment.mjs",
    "test:labcare": "vite build --config vite.labcare.config.mjs && node .labcare-out/labcare.mjs",
    "test:xlsx": "vite build --config vite.xlsx.config.mjs && node .xlsx-out/xlsx.mjs",
    "test:sql": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/bridge_contract.sql && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/bridge_hardening.sql",
    "e2e:internal": "node e2e/internal.mjs",
    "e2e:roundtrip": "node e2e/roundtrip.mjs",
    "test:all": "npm run test:contract && npm run test:client-ops && npm run test:client-operations && npm run test:progress && npm run test:persistence && npm run test:onboarding && npm run test:client-ops-alerts && npm run test:doc-parser && npm run test:client-ops-stage2 && npm run test:datamode && npm run test:autherrors && npm run test:mirae-os && npm run test:consulting && npm run test:operator && npm run test:startup-tax && npm run test:cretop && npm run test:tools && npm run test:employment && npm run test:labcare && npm run test:xlsx",
    "e2e:mobile": "node e2e/mobile-journey.mjs",
    "qa:board": "node e2e/board.mjs",
    "qa:tax": "node e2e/tax-parity.mjs",
    "qa:shell": "node e2e/shell.mjs",
    "qa:tools": "node e2e/tools.mjs",
    "qa:todos": "node e2e/todos.mjs",
    "qa:studio": "node e2e/studio.mjs",
    "qa:simple": "node e2e/simple.mjs",
    "qa:shots": "node e2e/shots.mjs",
    "qa:modules": "node e2e/modules.mjs",
    "qa:squeeze": "node e2e/squeeze.mjs",
    "qa:themes": "node e2e/themes.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.25.0",
    "pdfjs-dist": "^6.3.289",
    "pdfjs-dist-v4": "npm:pdfjs-dist@^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}

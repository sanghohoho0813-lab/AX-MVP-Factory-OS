# AX MVP Factory OS — 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. (.env 는 커밋되지 않습니다)

# Supabase (이 프로젝트 전용 새 Supabase 프로젝트를 사용하세요.
#  ⚠️ 미래 AI 랩 쇼핑몰의 Supabase 프로젝트를 절대 사용하지 마세요.)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 개발 전용 목(mock) 모드 — Supabase 없이 UI 를 확인할 때만 1 로 설정.
# 데이터는 브라우저 메모리에만 존재하며 새로고침 시 사라집니다. 운영에서는 절대 사용 금지.
# VITE_DEV_MOCK=1

# AX MVP Factory OS — 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. (.env 는 커밋되지 않습니다.)
# 이 파일에는 키 "이름"만 두고, 실제 Secret 값은 절대 커밋하지 마세요.

# 데이터 모드: local(브라우저 로컬 데모) 또는 supabase(클라우드 저장)
VITE_DATA_MODE=local

# Supabase (VITE_DATA_MODE=supabase 일 때만 필요)
# 이 프로젝트 전용 Supabase 프로젝트를 사용하세요. 다른 서비스의 프로젝트를 재사용하지 마세요.
# 브라우저에는 anon key만 사용합니다. service_role 키는 절대 프런트엔드에 넣지 마세요.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
